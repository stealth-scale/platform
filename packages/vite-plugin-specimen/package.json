{
  "name": "@stealthscale/vite-plugin-specimen",
  "version": "0.0.0",
  "description": "Indexes specimen files from their source, so a catalogue lists every page without loading one.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/platform.git",
    "directory": "packages/vite-plugin-specimen"
  },
  "files": [
    "client.d.ts",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./client": "./client.d.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./client": "./client.d.ts"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts"
  },
  "devDependencies": {
    "@stealthscale/testing": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:peer"
  }
}
