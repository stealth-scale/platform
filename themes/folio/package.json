{
  "name": "@stealthscale/theme-folio",
  "version": "0.0.0",
  "description": "An editorial theme: a violet brand, larger body text and a serif to read it in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/platform.git",
    "directory": "themes/folio"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/fonts.ts",
    "./dist/fonts.mjs",
    "*.css"
  ],
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./fonts": {
      "stealth-source": "./src/fonts.ts",
      "default": "./dist/fonts.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./fonts": "./dist/fonts.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/fonts.ts"
  },
  "dependencies": {
    "@fontsource-variable/literata": "catalog:",
    "@fontsource-variable/source-code-pro": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@stealthscale/theme": "workspace:^",
    "react": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "react": "catalog:"
  }
}
