{
  "name": "@stealthscale/component-controls",
  "version": "0.0.0",
  "description": "Draws the things a person operates, one at a time: a button, a field, a slider, a switch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/ui.git",
    "directory": "components/controls"
  },
  "files": [
